<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Declared without an intent filter: the redirect URI belongs to the integrator, not to
      the SDK. The app re-declares this activity with its own filter and the manifest merger
      unions the two. See VersolaRedirectActivity's documentation for the snippet.

      singleInstance, so it always runs alone in a task of its own and never in the app's. Any
      app can start this exported activity; if it ran in the app's task, an intent that is not
      the redirect would still raise the app over the open browser tab (measured on an API 36
      emulator: the tab was left hidden behind the app). In a task of its own, ignoring an
      intent leaves the tab in front, and a real redirect raises the app by starting its
      launcher activity from this one. excludeFromRecents keeps the task of an
      ignored intent out of Recents.
    -->
    <application>
        <activity
            android:name="versola.sdk.browser.VersolaRedirectActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
          The Auth Tab trampoline: launches the tab through the activity-result API and
          delivers its result (AuthTabAuthorizationSession). Not exported: only the SDK starts
          it, with an explicit intent. Translucent rather than NoDisplay because it must stay
          alive, under the tab, until the result arrives; a NoDisplay activity has to finish
          before it resumes. It is never the task root the user returns to: finishing it lands
          the user on whatever was below.
        -->
        <activity
            android:name="versola.sdk.browser.VersolaAuthTabActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

    <!--
      Android 11+ package visibility: without this the SDK cannot see which browsers are
      installed, CustomTabsClient.getPackageName returns null on every device, and the flow
      silently degrades to the ACTION_VIEW fallback. Mirrors the query androidx.browser's own
      documentation prescribes.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

</manifest>
