{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://versola.io/schemas/mobile-sdk/conformance-scenario.json",
  "title": "Versola mobile SDK conformance scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "issues", "applies_to", "mode", "preconditions", "steps", "assertions"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9-]+$",
      "description": "Matches the file name without its extension."
    },
    "title": { "type": "string", "minLength": 1 },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 },
      "description": "Issues this scenario is acceptance criteria for."
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["android", "ios", "flutter", "react-native"] }
    },
    "facade": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["versola", "oauth"] },
      "description": "Facades the scenario holds for. Absent means [versola]. 'oauth' is the generic facade of spec/oauth-sdk-api.md, run against every provider in spec/providers.md."
    },
    "mode": {
      "enum": ["dpop", "bearer", "any"],
      "description": "Token binding the scenario runs under. 'any' means it must pass in both."
    },
    "fault_injection": {
      "type": "array",
      "items": {
        "enum": [
          "drop-response",
          "force-dpop-nonce",
          "always-demand-dpop-nonce",
          "clock-skew",
          "process-death",
          "omit-discovery-field",
          "network-partition",
          "respond-with-status"
        ]
      },
      "description": "Harness capabilities the scenario requires. See conformance/README.md."
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor", "action"],
        "properties": {
          "actor": { "enum": ["app", "sdk", "auth", "edge", "provider", "harness", "user", "os"] },
          "action": { "type": "string", "minLength": 1 },
          "expect": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Observable, machine-checkable outcomes. Not prose about intent."
    },
    "notes": { "type": "string" }
  }
}
