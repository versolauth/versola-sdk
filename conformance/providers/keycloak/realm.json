{
  "realm": "conformance",
  "enabled": true,
  "displayName": "Versola SDK conformance",
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clients": [
    {
      "clientId": "conformance-app",
      "name": "Versola SDK conformance (public client, PKCE S256)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://conformance.example.com/oauth"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://conformance.example.com/signed-out",
        "require.pushed.authorization.requests": "false"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "basic",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "conformance-app-norefresh",
      "name": "Versola SDK conformance (no refresh token, 10 s access tokens; scenario 31)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://conformance.example.com/oauth"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://conformance.example.com/signed-out",
        "require.pushed.authorization.requests": "false",
        "use.refresh.tokens": "false",
        "access.token.lifespan": "10"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "basic",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "conformance-app-dpop",
      "name": "Versola SDK conformance (public client that requires DPoP-bound tokens; scenario 33)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://conformance.example.com/oauth"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://conformance.example.com/signed-out",
        "require.pushed.authorization.requests": "false",
        "dpop.bound.access.tokens": "true"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "basic",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "email": "alice@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        }
      ]
    }
  ]
}
